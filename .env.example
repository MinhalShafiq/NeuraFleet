ANTHROPIC_API_KEY=your-api-key-here
ENVIRONMENT=development
LOG_LEVEL=info
# json (default; one object per line, for log shippers) or text (human-readable)
LOG_FORMAT=json
# Browser origins allowed to call the gateway API directly, comma-separated.
# The dashboard itself uses same-origin /api, so this only matters for other front-ends.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

